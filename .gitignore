# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# build output (covered by vitest exclude; safeguard for git)
/dist

# Tauri desktop build artifacts + large binaries
/src-tauri/binaries/
/src-tauri/target/
/src-tauri/gen/
/src-tauri/frontend-dist/
/.tauri-cache/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# lockfile — standardised on npm
bun.lock

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Runtime data (never commit)
db/
data/
gbp-monitor/data/backups/
gbp-monitor/data/run.log
# Tenant-scoped runtime data (snapshots/deltas/run_summary per business).
# Explicit even though `data/` already matches — documents intent + survives
# any future narrowing of the blanket rule.
gbp-monitor/data/users/
gbp-monitor/config/user-business.json
# Real notification delivery config (webhook URLs / SMTP creds).
# Commit notifications.example.json as template instead.
gbp-monitor/config/notifications.json
gbp-monitor/config/schedule.json
.rother/
tool-results/
_audit_reviews_*.json
.zscripts/dev.pid

# Nested or accidental git artifacts
Rother - *
rother02-archive/
imagetest/
opencode.json
part_of_chat_history.md
rotherv0.3.2_screenshot_ui/

# Prisma migrations (generate on deploy)
prisma/migrations/